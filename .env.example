# Supabase PostgreSQL connection string. Use the pooled connection in production.
DATABASE_URL=postgresql://postgres.project-ref:password@host:6543/postgres

# Supabase requires TLS. Set to false only for a trusted local PostgreSQL instance.
DATABASE_SSL=true

# Supabase's pooler uses a private root CA that Node does not ship. Point this at
# the PEM to keep certificate verification enabled. Download your own copy from
# Project Settings -> Database -> SSL Configuration.
DATABASE_CA_CERT=supabase/prod-ca-2021.crt

# How often the dashboard re-reads the database, in milliseconds. Set to 0 to
# poll only on focus and after edits.
NEXT_PUBLIC_ARC_POLL_MS=10000

# Supabase Storage, for files attached to support messages. Without these the
# composer's paperclip reports that attachments are not configured; everything
# else works. Create a PRIVATE bucket named below in Supabase -> Storage, and
# take the service role key from Project Settings -> API.
#
# The service role key bypasses row level security. It is only ever read
# server-side (src/lib/storage.js) and must never be given the NEXT_PUBLIC_
# prefix, which would ship it to the browser.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=support-attachments

# Signs the session cookie. Required in production — sign-in throws without it.
# Development falls back to a fixed built-in value. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
SESSION_SECRET=
